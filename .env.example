# ═══════════════════════════════════════════════════════════════════════════
#  .env — ІНФРАСТРУКТУРА ТІЛЬКИ
#
#  Рішення Романа (2026-08-17): операційні налаштування — токени, SMTP/IMAP,
#  WAHA, ліміти, режим dry_run/live — живуть у Postgres (секрети зашифровані)
#  і редагуються в UI на сторінці **/settings**. Вони діють наживо: фабрика
#  перечитує їх протягом ~15 секунд, без перезапуску і без ребілду.
#
#  Тут лишається лише те, без чого нема звідки читати ті налаштування,
#  або чим захищено саму сторінку налаштувань.
#
#  Порядок розв'язання значення в рантаймі:  БД → env → дефолт.
#  Тобто змінна тут — робочий fallback для свіжої машини чи відкату; щойно
#  ключ збережено в UI, виграє БД.
#
#  Повний список того, що налаштовується в UI: див. SETUP.md і сам /settings.
# ═══════════════════════════════════════════════════════════════════════════

# ─── База даних ──────────────────────────────────────────────────────────────
DATABASE_URL=postgres://factory:factory@localhost:5432/factory
POSTGRES_PASSWORD=factory

# ─── Сховище evidence ────────────────────────────────────────────────────────
# s3 (MinIO/R2) або fs (локальна тека ./storage, режим без залежностей)
STORAGE_MODE=s3
STORAGE_DIR=storage
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=factory
S3_SECRET_KEY=factorysecret
S3_BUCKET_RAW=factory-raw
S3_BUCKET_ASSETS=factory-assets

# ─── Ключ шифрування налаштувань ─────────────────────────────────────────────
# 32 байти (hex або base64). Ним AES-256-GCM шифруються ВСІ секрети в таблиці
# `settings`, тому дамп БД без цього ключа марний.
#
#   echo "SETTINGS_MASTER_KEY=$(openssl rand -hex 32)" >> .env
#
# УВАГА: після зміни ключа всі вже збережені секрети стануть нечитабельними —
# їх доведеться ввести в UI заново. Тримай його в бекапі разом із паролем БД.
SETTINGS_MASTER_KEY=

# ─── Доступ до консолі ───────────────────────────────────────────────────────
# Один спільний пароль: це консоль одного оператора, не мультитенант.
# Лишається тут, а не в БД, свідомо: ним захищена сама сторінка, де
# редагується все інше — тримати його за нею було б замкненим колом.
UI_PASSWORD=
# Підписує cookie сесії. Порожньо = використовується UI_PASSWORD.
UI_SESSION_SECRET=

# Спільний секрет, яким UI звертається до внутрішніх ендпоінтів фабрики
# (/internal/check/*, /internal/effective-config) — кнопки «Перевірити»
# маршрутизуються factory API до процесу, який реально володіє залежністю;
# агентні CLI та їх credentials живуть тільки в runner executor.
# Порожньо = використовується UI_SESSION_SECRET / UI_PASSWORD.
INTERNAL_API_KEY=

# Factory → trusted runner gateway authentication. Generate independently from
# the UI/API secret: `openssl rand -hex 32`. Compose requires a non-empty value.
RUNNER_API_KEY=
# Separate gateway → executor key. Factory/UI must never receive this value.
RUNNER_EXECUTOR_API_KEY=
# Direct runtime execution is for an explicit host development session only;
# docker-compose overrides this to `remote` for both factory services.
AGENT_EXECUTION_MODE=local-development
RUNNER_GATEWAY_URL=http://127.0.0.1:8790
RUNNER_SITES_ROOT=sites
RUNNER_INPUTS_ROOT=/tmp/websites-factory-agent-inputs
# One-time migration only: seed an old DB-held Claude token into runner storage,
# verify it, then return this to false and remove the old setting in U9 rollout.
RUNNER_SEED_CLAUDE_CREDENTIAL=false
# Completed/retriable runner scratch is retained for 7 days, then pruned.
RUNNER_WORK_RETENTION_HOURS=168
# Hard memory ceiling for the provider executor (browser + CLI + build).
RUNNER_MEMORY_LIMIT=6g
# Keep DNS exfiltration protection enabled in production. Set to false only
# when unrestricted DNS is an explicit operational choice.
RUNNER_DNS_PROTECTION_ENABLED=true

# ─── Топологія compose ───────────────────────────────────────────────────────
# Це не операторські налаштування, а адреси всередині мережі docker.
DASHBOARD_PORT=8787
DEMO_PORT=8788
# Всередині compose: http://gosom:8080. З хоста (pnpm dev): http://127.0.0.1:8085.
GOSOM_URL=http://127.0.0.1:8085
# Як UI бачить внутрішній API фабрики.
FACTORY_API_URL=http://factory:8787
# На Apple Silicon: devlikeapro/waha:noweb-arm (NOWEB не потребує Chromium).
WAHA_IMAGE=devlikeapro/waha:noweb
WAHA_ENGINE=NOWEB
# WAHA читає ці змінні сама (не через наш settings-стор): вони конфігурують
# сам контейнер WAHA. Значення API key має збігатися з тим, що збережене в UI.
WAHA_API_KEY=
WAHA_HOOK_HMAC_KEY=
WAHA_SESSION=default
WAHA_HOOK_URL=http://factory:8787/webhooks/waha
WAHA_DASHBOARD_USERNAME=waha
WAHA_DASHBOARD_PASSWORD=
# Дозволяє placeholder-креденшели WAHA — ТІЛЬКИ для локальної розробки на 127.0.0.1.
WAHA_ALLOW_DEV_KEY=false

# Таймзона контейнерів. Node читає TZ на старті процесу, тому зміна цього
# значення (на відміну від решти) потребує перестворення контейнерів.
TZ=Europe/Athens

# ═══════════════════════════════════════════════════════════════════════════
#  РЕШТА — В UI: http://localhost:3000/settings
#
#  Агенти:    підключення Claude/Codex у «Акаунтах», AGENT_RUNTIME,
#             AGENT_MODEL(_HEAVY), AGENT_CONCURRENCY*
#  Telegram:  TELEGRAM_BOT_TOKEN, TELEGRAM_CHAT_ID
#  Email:     SMTP_*, IMAP_*
#  WhatsApp:  WAHA_URL / API key / сесія / HMAC (+ QR прямо на сторінці)
#  Медіа:     MEDIA_GEN_IMAGES
#  Outreach:  FACTORY_MODE (dry_run/live), OUTREACH_DAILY_LIMIT,
#             FOLLOWUP_SCHEDULE_DAYS, DEMO_BASE_URL
#  Система:   UI_BASE_URL, SOCIAL_DISCOVERY*, GOSOM_* ліміти, WORKSPACE_GC
#
#  Якщо якийсь ключ ще не збережений в UI, можна тимчасово покласти його сюди
#  як env — воно спрацює як fallback. Але штатний шлях — сторінка налаштувань.
# ═══════════════════════════════════════════════════════════════════════════
