{
  "name": "websites-factory",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.24.0",
  "type": "module",
  "description": "Autonomous factory: discover local businesses -> evidence package -> personalized demo site -> approval-gated outreach",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/db/migrate.ts",
    "factory": "tsx src/cli.ts",
    "workers": "tsx src/workers/main.ts",
    "api": "tsx src/api/server.ts",
    "runner:gateway": "tsx src/runner/gateway.ts",
    "runner:executor": "tsx src/runner/executor.ts",
    "all": "tsx src/main.ts",
    "e2e": "tsx --tsconfig scripts/e2e/tsconfig.json scripts/e2e.ts",
    "import:legacy": "tsx scripts/import-legacy.ts",
    "verify:media": "tsx scripts/verify-media.ts",
    "test:settings": "tsx scripts/test-settings.ts",
    "test:accounts": "tsx scripts/test-accounts-parse.ts",
    "test:brand-agent": "tsx scripts/test-brand-agent.ts",
    "test:brand-refresh-flow": "tsx scripts/test-brand-refresh-flow.ts",
    "test:build-log": "tsx scripts/test-build-log.ts",
    "test:check-cache": "tsx scripts/test-check-cache.ts",
    "test:toast": "tsx scripts/test-toast.ts",
    "test:inbox-policy": "tsx --tsconfig scripts/e2e/tsconfig.json scripts/test-inbox-policy.ts",
    "test:build-failure-decision": "tsx --tsconfig scripts/e2e/tsconfig.json scripts/test-build-failure-decision.ts",
    "test:status-transitions": "tsx scripts/test-status-transitions.ts",
    "test:discovery-resilience": "tsx scripts/test-discovery-resilience.ts",
    "test:business-transition-api": "tsx scripts/test-business-transition-command-api.ts",
    "test:outreach-decision-api": "tsx scripts/test-outreach-decision-command-api.ts",
    "test:campaign-command-api": "tsx scripts/test-campaign-command-api.ts",
    "test:build-review-decision": "tsx scripts/test-build-review-decision.ts",
    "test:enrichment-barrier": "tsx scripts/test-enrichment-barrier.ts",
    "test:workspace-dependencies": "tsx scripts/test-workspace-dependencies.ts",
    "test:visual-qa-decision": "tsx --tsconfig scripts/e2e/tsconfig.json scripts/test-visual-qa-decision.ts",
    "test:telegram-copy": "tsx scripts/test-telegram-copy.ts",
    "test:interrupted-build": "tsx --tsconfig scripts/e2e/tsconfig.json scripts/test-interrupted-build.ts",
    "test:landing-gallery": "tsx scripts/test-landing-gallery.ts",
    "test:tmux-agent": "tsx scripts/test-tmux-agent.ts",
    "test:agent-result-lifecycle": "tsx scripts/test-agent-result-lifecycle.ts",
    "test:agent-runner": "tsx scripts/test-agent-runner.ts",
    "test:runner-isolation": "tsx scripts/test-runner-isolation.ts",
    "test:fixture-safety": "tsx scripts/test-fixture-safety.ts",
    "test:outreach-mode": "tsx scripts/test-outreach-mode.ts",
    "test:layout-quality": "tsx scripts/test-layout-quality.ts",
    "test:ui-shared-contracts": "tsx scripts/test-ui-shared-contracts.ts",
    "test:smoke:compose": "tsx scripts/run-isolated-factory-task.ts smoke",
    "test:integration:compose": "tsx scripts/run-isolated-factory-task.ts integration",
    "release:gate": "tsx scripts/release-gate.ts",
    "telegram:setup": "tsx src/telegram/bot.ts",
    "ui:dev": "pnpm --dir ui dev",
    "ui:build": "pnpm --dir ui build",
    "phasec:unit": "tsx scripts/phaseC-unit.ts",
    "phasec:fonts": "tsx scripts/phaseC-fonts.ts",
    "phasec:workspace": "tsx scripts/phaseC-workspace-dryrun.ts",
    "phasec:deploy-check": "tsx scripts/phaseC-deploy-check.ts",
    "phasec:qa": "tsx scripts/phaseC-qa-only.ts",
    "phasec:run": "tsx scripts/phaseC-run.ts",
    "phasec:fixture": "tsx scripts/phaseC-fixture.ts",
    "phasec:critic-check": "tsx scripts/phaseC-critic-check.ts",
    "phasee:e2e": "tsx scripts/phaseE-e2e.ts",
    "phasee:mail": "docker compose --profile dev-mail up -d greenmail"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.233",
    "@aws-sdk/client-s3": "^3.700.0",
    "@hono/node-server": "^1.13.0",
    "dotenv": "^16.4.5",
    "drizzle-orm": "^0.44.0",
    "grammy": "^1.30.0",
    "hono": "^4.6.0",
    "imapflow": "^1.0.171",
    "mailparser": "^3.7.0",
    "nanoid": "^5.0.9",
    "nodemailer": "^6.9.16",
    "pg": "^8.13.0",
    "pg-boss": "^10.1.5",
    "playwright": "^1.49.0",
    "yaml": "^2.6.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@types/mailparser": "^3.4.5",
    "@types/node": "^22.10.0",
    "@types/nodemailer": "^6.4.17",
    "@types/pg": "^8.11.10",
    "drizzle-kit": "^0.31.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0"
  }
}
