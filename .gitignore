node_modules/
**/node_modules/
dist/
*.log
.artifacts/

# Secrets. `.env.example` is the committed template.
.env
.env.*
!.env.example
ui/.env
ui/.env.*

# Runtime output. Regenerated by the pipeline; belongs in volumes, not in git.
# (No trailing comments on these lines: gitignore treats them as part of the pattern.)
storage/
sites/
deploys/

# Build output.
.next/
**/.next/
site-template/out/

# Screenshots from QA/verification runs. `docs/evidence/` is committed on
# purpose (small PNGs proving a run happened); these are the noisy ones.
.screenshots/
ui/.screenshots/

.DS_Store
**/.DS_Store

# One-off verification screenshots from local runs (100MB+). They stay on the
# machine that produced them; the reports referencing them live in docs/.
docs/evidence/
docs/audit/shots/
