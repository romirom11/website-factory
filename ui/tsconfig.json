{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "esnext",
    "moduleResolution": "bundler",
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "incremental": true,
    "allowJs": true,
    "plugins": [{ "name": "next" }],
    "paths": {
      "@/*": ["./*"],
      "@factory/schema": ["./factory/schema.ts"],
      "@factory/buildPolicy": ["./factory/buildPolicy.ts"],
      "@factory/settings": ["./factory/settings.ts"],
      "@factory/models": ["./factory/models.ts"],
      "@factory/jobDefinitions": ["./factory/jobDefinitions.ts"],
      "@factory/businessStatus": ["./factory/businessStatus.ts"]
    }
  },
  "include": ["next-env.d.ts", "**/*.ts", "**/*.tsx", ".next/types/**/*.ts"],
  "exclude": ["node_modules"]
}
