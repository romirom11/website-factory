# External DNS is limited to the same provider/package zones as the proxy.
# Docker's embedded resolver still answers service names on the executor's own
# internal networks, then forwards public queries here.
anthropic.com:53 claude.ai:53 openai.com:53 chatgpt.com:53 oaiusercontent.com:53 opencode.ai:53 openrouter.ai:53 kimi.com:53 moonshot.ai:53 moonshot.cn:53 npmjs.org:53 yarnpkg.com:53 {
    errors
    cache 300
    forward . /etc/resolv.conf {
        policy sequential
        max_fails 2
    }
}

.:53 {
    errors
    health 0.0.0.0:8080
    ready 0.0.0.0:8181
    template IN ANY . {
        rcode REFUSED
    }
}
