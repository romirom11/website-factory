FROM node:22-bookworm AS dependencies

# A system install is shared by the root build and uid-1000 runtime. Corepack's
# per-user cache would otherwise make every container start depend on npmjs.org.
RUN npm install --global pnpm@11.24.0
WORKDIR /app

COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
RUN pnpm install --frozen-lockfile

# Runtime containers have a read-only root filesystem. Compile once while the
# image is writable so their entrypoints can execute Node directly instead of
# asking pnpm to perform a dependency-status check under /app at every start.
FROM dependencies AS runner-build
COPY . .
RUN pnpm build

# A single static binary supplies dependency-free TCP/HTTP health probes for
# the otherwise minimal proxy and DNS images.
FROM busybox:1.37.0-musl AS health-tools

FROM debian:bookworm-slim AS egress-proxy
RUN apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates squid \
    && rm -rf /var/lib/apt/lists/* \
    && mkdir -p /var/spool/squid /var/log/squid \
    && chown -R proxy:proxy /var/spool/squid /var/log/squid
COPY infra/agent-proxy/squid.conf /etc/squid/squid.conf
COPY --from=health-tools /bin/busybox /busybox
RUN squid -z -f /etc/squid/squid.conf \
    && squid -k parse -f /etc/squid/squid.conf
USER proxy
EXPOSE 3128
CMD ["squid", "-N", "-f", "/etc/squid/squid.conf", "-d", "1"]

FROM coredns/coredns:1.12.4 AS egress-dns
COPY infra/agent-dns/Corefile /Corefile.true
COPY infra/agent-dns/Corefile.unprotected /Corefile.false
COPY --from=health-tools /bin/busybox /busybox
EXPOSE 53/udp 53/tcp 8080 8181
ENTRYPOINT ["/coredns"]
CMD ["-conf", "/Corefile.true"]

FROM runner-build AS gateway
RUN mkdir -p /app/sites /app/agent-inputs /app/runner-work \
    && chown -R node:node /app /home/node
USER node
CMD ["node", "dist/runner/gateway.js"]

FROM dependencies AS executor

# Subscription runtimes exist only in this image. Factory images contain the
# control plane and deterministic workers, never provider auth mounts. Versions
# are deliberately pinned to the releases exercised by the runtime adapters;
# an upstream CLI flag/parser change must arrive as a reviewed dependency bump.
ARG CLAUDE_CODE_VERSION=2.1.239
ARG CODEX_CLI_VERSION=0.149.1
ARG OPENCODE_VERSION=1.18.23
RUN npm i -g \
      "@anthropic-ai/claude-code@${CLAUDE_CODE_VERSION}" \
      "@openai/codex@${CODEX_CLI_VERSION}" \
      "opencode-ai@${OPENCODE_VERSION}" \
    && claude --version && codex --version && opencode --version

RUN codex_native="$(find /usr/local/lib/node_modules/@openai/codex/node_modules \
         -path '*/vendor/*/bin/codex' -type f -print -quit)" \
    && test -n "$codex_native" \
    # The native CLI multiplexes these helpers by argv[0]. The npm launcher
    # does not install their links, so a nested bubblewrap otherwise fails at
    # execvp even though the sandbox implementation is present in the binary.
    && ln -s "$codex_native" /usr/local/bin/codex-linux-sandbox \
    && ln -s "$codex_native" /usr/local/bin/codex-execve-wrapper

ENV PLAYWRIGHT_BROWSERS_PATH=/ms-playwright
# Runner browser tooling is headless. Avoid shipping a second, unused headed
# Chromium binary in the most frequently rebuilt production image.
RUN npx playwright install --with-deps --only-shell chromium \
    && chmod -R a+rx /ms-playwright

RUN apt-get update && apt-get install -y --no-install-recommends bubblewrap ffmpeg socat tmux \
    && rm -rf /var/lib/apt/lists/* \
    && bwrap --version \
    && tmux -V

ARG TTYD_VERSION=1.7.7
ARG TTYD_SHA256_X86_64=8a217c968aba172e0dbf3f34447218dc015bc4d5e59bf51db2f2cd12b7be4f55
ARG TTYD_SHA256_AARCH64=b38acadd89d1d396a0f5649aa52c539edbad07f4bc7348b27b4f4b7219dd4165
RUN set -eux; \
    case "$(dpkg --print-architecture)" in \
      amd64)  arch=x86_64;  sha="$TTYD_SHA256_X86_64" ;; \
      arm64)  arch=aarch64; sha="$TTYD_SHA256_AARCH64" ;; \
      *) echo "no ttyd build for $(dpkg --print-architecture)" >&2; exit 1 ;; \
    esac; \
    curl -fsSL -o /usr/local/bin/ttyd \
      "https://github.com/tsl0922/ttyd/releases/download/${TTYD_VERSION}/ttyd.${arch}"; \
    echo "${sha}  /usr/local/bin/ttyd" | sha256sum -c -; \
    chmod +x /usr/local/bin/ttyd; \
    ttyd --version

# Keep application changes after the expensive pinned CLI/toolchain layers so
# normal releases reuse those Docker cache entries. The compiled output comes
# from the single shared build stage used by both runner services.
COPY . .
COPY --from=runner-build /app/dist ./dist
COPY --chmod=0555 infra/agent-dns/start-executor.sh /usr/local/bin/start-runner-executor
RUN mkdir -p /app/runner-work/.private/credentials /app/.claude/skills \
      /app/runner-work/.private/codex \
      /app/runner-work/.private/provider/opencode \
      /home/node/.cache /home/node/runtime-home /home/node/.local/state \
    && cp -r /app/skills/. /app/.claude/skills/ \
    && chown -R node:node /app /home/node

ENV CODEX_HOME=/app/runner-work/.private/codex
ENV XDG_DATA_HOME=/app/runner-work/.private/provider
ENV XDG_CACHE_HOME=/home/node/.cache
ENV HOME=/home/node/runtime-home
ENV OPENCODE_DISABLE_AUTOUPDATE=1
USER node
CMD ["start-runner-executor"]
